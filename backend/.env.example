# LLM provider: ollama, lmstudio, or custom
LLM_PROVIDER=custom
LLM_BASE_URL=https://llm-provider.example/v1
LLM_MODEL_ID=provider-model-id
LLM_API_KEY=replace-with-provider-key
LOCAL_LLM=local-model-id
OLLAMA_BASE_URL=http://host.docker.internal:11434
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1

# Optional trusted cost rules; no pricing is assumed when unset
# LLM_PRICING_RULES_JSON=[{"provider":"custom","model_id":"provider-model-id","input_price_per_1m_tokens":"0","output_price_per_1m_tokens":"0","currency":"USD"}]

# Search provider: duckduckgo, tavily, perplexity, searxng, or advanced
SEARCH_API=duckduckgo
TAVILY_API_KEY=replace-with-tavily-key
PERPLEXITY_API_KEY=replace-with-perplexity-key
SEARXNG_URL=http://host.docker.internal:8888

# Persistent application data
RESEARCH_DB_PATH=./data/research.db
NOTES_WORKSPACE=./notes
ENABLE_NOTES=true

# Existing safe runtime limits and behavior
MAX_WEB_RESEARCH_LOOPS=3
MAX_CONCURRENT_RESEARCH_TASKS=3
FETCH_FULL_PAGE=true
STRIP_THINKING_TOKENS=true
USE_TOOL_CALLING=false

# Host port mappings used by local/Docker startup
BACKEND_PORT=8000
FRONTEND_PORT=6006

# Frontend build-time API base URL
VITE_API_BASE_URL=/api
